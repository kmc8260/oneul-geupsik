# ===================================================================
# 환경 설정 파일 예시
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 내 컴퓨터에 맞게 값을 채우세요.
# 서버(src/server.js)가 켜질 때 dotenv 라이브러리가 .env를 읽어서
# process.env.이름 으로 꺼내 씁니다.
# .env에는 비밀번호와 API 키가 들어가므로 깃허브 등에 올리지 마세요. (.gitignore에 들어 있어요)
# ===================================================================

# ----- MySQL 접속 정보 (src/db.js에서 사용) -----
DB_HOST=localhost              # MySQL이 설치된 컴퓨터 주소 (내 컴퓨터면 localhost)
DB_PORT=3306                   # MySQL 포트 번호 (기본값 3306)
DB_USER=root                   # MySQL 사용자 이름
DB_PASSWORD=비밀번호를_입력하세요   # MySQL Workbench에 접속할 때 쓰는 비밀번호
DB_NAME=oneul_geupsik          # 사용할 데이터베이스 이름 (db/schema.sql이 만드는 이름)

# ----- 웹 서버 설정 (src/server.js에서 사용) -----
PORT=3000                      # 브라우저에서 http://localhost:3000 으로 접속하게 됨
# 로그인 세션 쿠키를 암호화하는 데 쓰는 비밀 문자열. 아무 긴 문자열이면 됩니다.
SESSION_SECRET=change-this-to-a-long-random-string

# ----- 나이스 API (src/neis.js에서 사용) -----
# 나이스 교육정보 개방 포털(open.neis.go.kr)에서 발급받은 인증키
# 비워두면 키 없이 호출되어 결과가 5개까지만 나와요.
NEIS_API_KEY=

# ---- 배포할 때만 쓰는 설정 (내 컴퓨터에서는 그대로 두세요) ----
DB_AUTO_INIT=false   # true: 서버가 켜질 때 db/schema.sql을 자동 실행해 테이블 생성 (배포 사이트에서 true)
DB_SSL=false         # true: DB에 암호화 연결 (TiDB Cloud·Aiven 같은 클라우드 DB는 true 필요)
